# Each app has its own .gitignore too (admin-dashboard/, employee-pwa/, mobile-app/);
# this one covers repo-root-level stuff and acts as a safety net.

# dependencies
node_modules/

# env files anywhere in the repo (leave templates like .env.example)
.env
.env.*
!.env.example

# build output
dist/
dist-ssr/
build/

# built APKs (large binaries, not source)
*.apk
*.aab

# OS junk
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase CLI local state
supabase/.branches
supabase/.temp
